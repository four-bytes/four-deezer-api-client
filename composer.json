{
    "name": "four-bytes/deezer-api-client",
    "description": "PHP 8.4+ client for the Deezer API — built on four-http-client",
    "type": "library",
    "license": "MIT",
    "keywords": ["deezer", "api-client", "music", "streaming"],
    "authors": [{"name": "Four Bytes", "homepage": "https://github.com/four-bytes"}],
    "require": {
        "php": "^8.4",
        "four-bytes/four-http-client": "^4.0",
        "four-bytes/four-rate-limiting": "^1.3",
        "psr/cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "symfony/cache": "^7.2"
    },
    "suggest": {
        "symfony/http-client": "PSR-18 HTTP transport",
        "symfony/cache": "PSR-6 cache implementation for label caching"
    },
    "autoload": {
        "psr-4": {"Four\\Deezer\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Four\\Deezer\\Tests\\": "tests/"}
    },
    "repositories": [
        {
            "type": "path",
            "url": "/home/robby/four-api-clients/four-http-client",
            "options": {
                "versions": {
                    "four-bytes/four-http-client": "4.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/home/robby/four-rate-limiting",
            "options": {
                "versions": {
                    "four-bytes/four-rate-limiting": "1.3.0"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {"php-http/discovery": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests",
        "quality": ["@phpstan", "@test"]
    }
}
