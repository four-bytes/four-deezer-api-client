{
    "name": "four-bytes/deezer-api-client",
    "description": "Modern PHP 8.4+ API client for Deezer Public API with rate limiting and caching",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "deezer",
        "api-client",
        "music",
        "streaming",
        "rate-limiting"
    ],
    "authors": [
        {
            "name": "Four Bytes",
            "homepage": "https://github.com/four-bytes"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "symfony/cache": "^7.2"
    },
    "suggest": {
        "guzzlehttp/guzzle": "For using Guzzle as HTTP client",
        "symfony/cache": "For PSR-6 cache implementation",
        "four-bytes/four-rate-limiting": "For advanced rate limiting with marketplace presets"
    },
    "autoload": {
        "psr-4": {
            "Four\\Deezer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Four\\Deezer\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "/home/robby/four-rate-limiting"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level=8",
        "cs-check": "phpcs --standard=PSR12 src",
        "cs-fix": "phpcbf --standard=PSR12 src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
